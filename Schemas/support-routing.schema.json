{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryjake.ai/schemas/support-routing.schema.json",
  "title": "Customer support channel and agent routing configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultChannel",
    "channels",
    "defaultAgentProvider",
    "agentProviders",
    "routing"
  ],
  "$defs": {
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "displayName": { "type": "string", "minLength": 1 },
        "credentialSecretName": { "type": "string", "minLength": 1 },
        "credentialSecretNames": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userIDs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "locales": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": ["string", "number", "boolean", "null"] }
          }
        }
      }
    }
  },
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 2 },
    "defaultChannel": { "type": "string", "minLength": 1 },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/option" }
    },
    "defaultAgentProvider": { "type": "string", "minLength": 1 },
    "agentProviders": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/option" }
    },
    "humanHandoffAdapter": { "type": "string", "minLength": 1 },
    "routing": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match"],
        "anyOf": [{ "required": ["channel"] }, { "required": ["agentProvider"] }],
        "properties": {
          "channel": { "type": "string", "minLength": 1 },
          "agentProvider": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" },
          "match": { "$ref": "#/$defs/match" }
        }
      }
    }
  }
}
